# .env.example — every environment variable the app, the scripts and the
# systemd units read. Names only; values live in .env.local (dev) and in
# /etc/billing/*.env (server, root-only). Copy to .env.local and fill in.

# ── Database (pg direct) ─────────────────────────────────────────────────────
DATABASE_URL=
DIRECT_URL=

# ── App ──────────────────────────────────────────────────────────────────────
APP_URL=
INTERNAL_BASE_URL=
SETTINGS_ENC_KEY=
BILLING_CRON_SECRET=
CRM_CRON_SECRET=
GREEN_API_WEBHOOK_SECRET=

# ── Supabase storage (documents / media) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Email fallback (DB row wins, see src/lib/db/appSettings.ts) ──────────────
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=
# transport overrides — only the e2e environment sets these (→ Mailpit)
SMTP_HOST=
SMTP_PORT=
SMTP_REQUIRE_TLS=

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Integrations ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CRM_SYNC_URL=
CRM_DEBTORS_REST_URL=
CRM_DEBTORS_REST_KEY=
BLLINK_SYNC_MIN_ROWS=
BLLINK_SYNC_MIN_FRACTION=
CHROME_PATH=

# ── Monitoring (all optional — empty = Sentry off / no healthcheck pings) ─────
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=
# build-time only, for source-map upload (npm run deploy on the server)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
LOG_LEVEL=
HEALTHCHECK_REMINDERS_URL=

# ── Backup (billing-backup.service → /etc/billing/backup.env) ────────────────
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
HEALTHCHECK_BACKUP_URL=

# ── e2e (playwright.config.ts / docker-compose.e2e.yml) ──────────────────────
E2E_PORT=
MAILPIT_SMTP_PORT=
MAILPIT_HTTP_PORT=
MAILPIT_URL=
