# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# the template is names-only and is exempt in check:secrets — track it
!.env.example

# secret/editor backups — never commit (covers names .env* misses, e.g. prod.env.bak)
*.env.bak
*.env.save
*.env.old
*.swp
*~
*.bak
*.save
*.orig

# local audit reports (not committed)
SECURITY_AUDIT.md
RBAC_BUG_REPORT.md
RBAC_MANAGER_AUDIT.md

# AGENTS.md is TRACKED on purpose (was ignored until 22/08/2026). Its lower
# half is the gen-catalog.sh catalogue and does churn, but its upper half is the
# iron rules — byte-identical to CLAUDE.md's. An untracked rules file means
# different rules on every machine, which is exactly what happened when iron
# rule 12 was added and could not be pushed. Churn is the cheaper problem.

# Claude Code session artifacts + the vendored-skill lockfile that pins them.
# Nothing in the build, deploy or check:* pipeline reads either one, and the
# kit templates (not this repo) are the source of truth for agent tooling.
.claude/
skills-lock.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# design reference bundles (not committed)
ref/
