# Daily Bllink sync — copies billing's own 05:30 scrape (billing-bllink-scrape)
# into public.debtors via POST /api/sync/bllink (x-cron-secret).
# Install:
#   sudo cp deploy/systemd/billing-sync.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now billing-sync.timer
#   systemctl list-timers billing-sync.timer   # next run: tomorrow 06:00 Asia/Jerusalem
[Unit]
Description=ALMOG CRM — daily Bllink sync (one-shot)
After=network.target billing.service
Wants=billing.service
# The route records every refusal on sync_runs and turns the dashboard banner
# red, and run-bllink-sync.sh exits non-zero on it (curl --fail-with-body).
# A refusal at stage 'stale' means "billing's own scrape is not from today —
# nothing was copied"; this makes that an email + WhatsApp as well, not only a
# banner. See deploy/systemd/billing-alert@.service.
OnFailure=billing-alert@%n.service

[Service]
Type=oneshot
User=ubuntu
Group=devops-www
EnvironmentFile=/etc/billing/billing.env
ExecStart=/var/www/billing/scripts/run-bllink-sync.sh
# The copy + reconcile takes ~30s (the scrape itself ran at 05:30).
TimeoutStartSec=6min
