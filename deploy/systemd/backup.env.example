# /etc/billing/backup.env — read by billing-backup.service (root, chmod 600).
# Names only here; fill the values on the server. See docs/backup.md.

# Off-site restic repository (Backblaze B2). Unset = local dumps only, push skipped.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=

# healthchecks.io ping URL for the backup check. pg-backup.sh pings it on success
# and …/fail on error; restic-push.sh pings …/fail too, so an off-site push that
# dies after the dumps already reported green still turns the check red.
HEALTHCHECK_BACKUP_URL=

# Defaults (uncomment to override)
#PG_CONTAINER=supabase-db
#BILLING_DB=proj_billing
#BACKUP_DIR=/var/backups/supabase/daily
#RETENTION_DAYS=7
# Supabase Storage object BYTES (bind mount behind the storage-api container).
# Pushed as a second snapshot tagged `storage`. Set it to the empty string to opt
# out — and read the warning in scripts/backup/restic-push.sh before you do:
# pg_dumpall saves storage.objects, not the files, so without this a restore
# succeeds with every attachment and invoice a broken link.
#STORAGE_DIR=/opt/supabase/docker/volumes/storage
