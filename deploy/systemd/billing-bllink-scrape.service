# billing's own Bllink scraper — logs into Bllink, downloads the udnp report and
# stores the raw snapshot in public.bllink_scrapes(_rows) (kept 90 days). Writes
# nothing to debtors / sync_runs itself: /api/sync/bllink (billing-sync.timer,
# 06:00) copies this snapshot into debtors and refuses one that is not from
# today. The only source of debtors since the CRM (almog) was torn down on
# 06/10/2026 — until then each scrape was also compared with the CRM's snapshot.
# Install:
#   sudo cp deploy/systemd/billing-bllink-scrape.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now billing-bllink-scrape.timer
#   systemctl list-timers billing-bllink-scrape.timer   # next run: 05:30 Asia/Jerusalem
# Started by two paths (27/09/2026): this timer, and the dashboard's "סנכרן
# עכשיו" — POST /api/sync/bllink {"fresh":true} runs
# `sudo -n systemctl start --wait` on THIS unit (src/lib/sync/scrapeUnit.ts,
# rule in deploy/sudoers.d/billing-bllink-scrape). Two scrapes never overlap: the
# script takes a Postgres session advisory lock (src/lib/sync/scrapeLock.ts) and,
# when it is held, exits 0 without a run row — a skip, not a failure, so this
# unit's OnFailure= stays quiet.
# Manual run + log:
#   sudo systemctl start billing-bllink-scrape.service && journalctl -u billing-bllink-scrape -n 60
[Unit]
Description=ALMOG CRM — Bllink scrape (billing's own snapshot of the debt report) (one-shot)
After=network-online.target
Wants=network-online.target
# A scrape that dies silently is the 25/08–11/09/2026 outage again (17 days of
# frozen debt, nobody told). The script's own WhatsApp alert covers a failure it
# survives; OnFailure= also covers the ones it cannot report — a missing env
# var before the run row exists, the 5min TimeoutStartSec kill, an OOM kill.
# See deploy/systemd/billing-alert@.service. Drill passed 26/09/2026.
OnFailure=billing-alert@%n.service

[Service]
Type=oneshot
User=ubuntu
Group=devops-www
WorkingDirectory=/var/www/billing
# Read as root by systemd: BLLINK_USER/BLLINK_PASSWORD, PLAYWRIGHT_BROWSERS_PATH,
# DATABASE_URL, DIRECT_URL, SETTINGS_ENC_KEY, BLLINK_ALERT_PHONE.
EnvironmentFile=/etc/billing/billing.env
# Absolute node + local tsx — no PATH/npx dependence under systemd's minimal env
# (same as deploy/wa-queue-worker.service).
ExecStart=/usr/bin/node /var/www/billing/node_modules/tsx/dist/cli.mjs /var/www/billing/scripts/bllink-scrape.ts
# The script enforces its own 180s budget and records the failure; this is the backstop.
TimeoutStartSec=5min
Nice=5
