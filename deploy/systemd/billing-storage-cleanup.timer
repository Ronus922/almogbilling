[Unit]
Description=Run billing-storage-cleanup.service daily at 04:30 UTC

[Timer]
# 04:30 UTC — deliberately AFTER the nightly backup, not merely in a quiet hour.
#
# billing-backup.timer fires at 03:00 UTC with RandomizedDelaySec=10min, so the
# latest possible start is 03:10 UTC; measured runs take 40-60s (the Storage
# snapshot added ~15s on its first, full upload and is incremental afterwards).
# Even a run ten times slower than measured is done by 03:20 UTC, which leaves
# this at least 70 minutes of clearance.
#
# The time is pinned in UTC ON PURPOSE. It used to read `04:30 Asia/Jerusalem`,
# which is 01:30 UTC — an hour and a half BEFORE the backup it was supposed to
# follow — and a DST shift would have moved it against a backup that is pinned
# to UTC. Two schedules that must stay ordered have to share a clock.
#
# The clearance is the second line of defence, not the first:
# ExecStartPre=+scripts/backup/assert-storage-snapshot.sh asks the restic
# repository whether today's Storage snapshot actually exists, and refuses to
# start the job if it does not.
OnCalendar=*-*-* 04:30:00 UTC
# Catch up a missed run (server was down at 04:30).
Persistent=true
AccuracySec=1min
Unit=billing-storage-cleanup.service

[Install]
WantedBy=timers.target
