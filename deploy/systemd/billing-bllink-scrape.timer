[Unit]
Description=Run billing-bllink-scrape.service daily at 06:10 Asia/Jerusalem

[Timer]
# Ten minutes after billing-sync.timer (06:00) so the CRM snapshot of the same
# morning already exists when we compare. The host clock is UTC; the timezone
# suffix keeps the run at 06:10 local through DST changes.
OnCalendar=*-*-* 06:10:00 Asia/Jerusalem
# Catch up a missed run (server was down at 06:10).
Persistent=true
AccuracySec=1min
Unit=billing-bllink-scrape.service

[Install]
WantedBy=timers.target
