{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:allNonMajor"],
  "timezone": "Asia/Jerusalem",
  "schedule": ["* 0-5 * * 0"],
  "prConcurrentLimit": 3,
  "automerge": false,
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-5 * * 0"]
  },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "description": "Open the weekly lock file refresh before majors, so a backlog of majors under the 3-PR cap never starves it",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "prPriority": 1
    }
  ]
}
